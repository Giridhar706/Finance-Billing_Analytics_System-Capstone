@model FinanceBillingAnalytics.Models.ViewModels.RevenueSummaryViewModel

@{
    ViewData["Title"] = "Revenue Report";
}

<h2 class="mb-4">

    <i class="bi bi-graph-up-arrow"></i>
    Revenue Summary Report

</h2>

<div class="card shadow border-0 rounded-4">

    <div class="card-body">

        <div class="row">

            <div class="col-md-6">

                <div class="card bg-primary text-white mb-3">

                    <div class="card-body">

                        <h5>Total Invoices</h5>

                        <h2>
                            @Model.TotalInvoices
                        </h2>

                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <div class="card bg-success text-white mb-3">

                    <div class="card-body">

                        <h5>Total Revenue</h5>

                        <h2>
                            ₹ @Model.TotalRevenue
                        </h2>

                    </div>

                </div>

            </div>

        </div>

        <hr />

        <h5 class="mb-3">
            Revenue Overview
        </h5>

        <canvas id="reportChart"></canvas>

    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const ctx =
        document.getElementById('reportChart');

        new Chart(ctx,
        {
        type:'doughnut',
        data:
        {
        labels:
        [
        'Revenue',
        'Remaining'
        ],
        datasets:
        [
        {
        data:
        [
        @Model.TotalRevenue,
        200000
        ]
        }
        ]
        }
        });

    </script>

}
